# ============================================================================
# SAFE-TEE Demo Configuration
# ============================================================================
#
# Copy this file to .env.local and fill in real values:
#   cp .env .env.local
#
# Layout:
#   SAFETEE_SERVER  -- runs DKG + vetKey issuance + serves browser UI
#   INFERENCE       -- runs inference sidecar + vLLM on TDX+H100 CC VM
#
# The browser connects to SAFETEE_SERVER for crypto ops and sends encrypted
# frames to the sidecar. The sidecar calls back to SAFETEE_SERVER for
# vetKey decryption keys, decrypts the frame, runs vLLM, and returns
# the encrypted response.

# ── GCP Project ──
GCP_PROJECT=YOUR_GCP_PROJECT

# ── SAFE-TEE Server ──
SAFETEE_SERVER_HOST=YOUR_SERVER_IP
SAFETEE_SERVER_PORT=7777
SAFETEE_SERVER_ZONE=us-west2-a
SAFETEE_SERVER_INSTANCE=YOUR_SERVER_INSTANCE
SAFETEE_NODES=10
SAFETEE_THRESHOLD=7

# ── Inference (TDX H100 VM) ──
INFERENCE_HOST=YOUR_INFERENCE_IP
INFERENCE_SIDECAR_PORT=3001
INFERENCE_ZONE=us-central1-a
INFERENCE_INSTANCE=YOUR_INFERENCE_INSTANCE

# ── TLS (self-signed cert for camera access in Chrome) ──
# Leave empty to use plain HTTP
TLS_CERT=
TLS_KEY=

# ── Intel Trust Authority (for Tier 2 cryptographic attestation) ──
# Sign up at https://portal.trustauthority.intel.com to get a key
INTEL_TRUST_AUTHORITY_API_KEY=

# ── vLLM ──
VLLM_PORT=8000
VLLM_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
VLLM_MAX_MODEL_LEN=4096
